{
  "manifest_version": 3,
  "name": "Вибіркові ТНТУ — розумний підбір",
  "version": "1.16.0",
  "description": "Фільтри за кредитами, формою контролю й роком навчання, урахування обов’язкових з акаунта, звіт по семестрах і ШІ-підбір через Gemini на dl.tntu.edu.ua.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "author": "Oleksandr Klishch",
  "homepage_url": "https://github.com/OleksandrHub",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dl.tntu.edu.ua/mods/elective_courses/*"
      ],
      "js": [
        "app.js",
        "content/common.js",
        "content/mandatory.js",
        "content/electives.js",
        "content/curriculum.js",
        "content/account.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "css/*.css",
        "courses.json"
      ],
      "matches": [
        "https://dl.tntu.edu.ua/*"
      ]
    }
  ]
}

{
  "manifest_version": 3,
  "name": "Вибіркові ТНТУ — розумний підбір",
  "version": "1.3.1",
  "description": "Фільтри за кредитами, формою контролю й роком навчання, урахування обов’язкових з акаунта, звіт по семестрах і ШІ-підбір через Gemini на dl.tntu.edu.ua.",
  "permissions": ["storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://dl.tntu.edu.ua/mods/elective_courses/*"],
      "js": ["app.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["style.css", "courses.json"],
      "matches": ["https://dl.tntu.edu.ua/*"]
    }
  ]
}
